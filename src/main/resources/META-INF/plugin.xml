<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cz.crumbssoft.epochtimegenerator</id>

    <name>EpochTimeGenerator</name>

    <vendor url="https://www.crumbs-software.cz">Crumbs Software</vendor>

    <description><![CDATA[
        It is simple plugin to generate millies from epoch start on cursor in generet submenu.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>
    <actions>
        <action
                id="InsertEpochMillis"
                class="cz.crumbssoft.epochtimegenerator.InsertEpochMillisAction"
                text="Epoch millis"
                description="Vloží aktuální čas v ms od epochy">

            <add-to-group
                    group-id="GenerateGroup"
                    anchor="last"/>
        </action>
    </actions>
</idea-plugin>
